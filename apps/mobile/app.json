{
  "expo": {
    "name": "AvanceObra",
    "slug": "avanceobra",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "avanceobra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "co.avanceobra.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Para fotos de evidencia y escanear códigos QR de elementos.",
        "NSLocationWhenInUseUsageDescription": "Para georreferenciar los registros de avance y hallazgos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.avanceobra.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-camera",
        {
          "cameraPermission": "Para fotos de evidencia y escanear códigos QR de elementos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para georreferenciar los registros de avance y hallazgos."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Para fotos de evidencia."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86e6b8bf-9c0e-4e20-9d5a-e899ca6cae34"
      }
    },
    "owner": "eddiecardenas",
    "updates": {
      "url": "https://u.expo.dev/86e6b8bf-9c0e-4e20-9d5a-e899ca6cae34"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
